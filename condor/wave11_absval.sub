# HTCondor submit file for the wave-11 governed-absorber validation
# (fidelity loop, pre-registered item C).
#
# One job per (config, seed): 40 jobs x 20000 events (800k events total,
# ~50 CPU-h). abs_gov_val s1-10, abs_gov_od s1-10, abs_fd_od_plus/minus
# s1-10 each. No sub-job splitting: the n=1000 od timing smoke projects
# ~3100 s per 20k unit at a=3.0, well inside the 10800 s in-process timeout.
# The runner appends its per-unit JSONL directly to EOS
# (fidelity/wave11_runs/<config>_s<seed>.jsonl); EOS writes need the
# kerberos credential (MY.SendCredential). Condor log/out/err live on AFS
# (EOS-hosted condor logs are unreliable).
#
# NOTE (CERN gotcha): standard batch schedds REJECT any /eos path in the
# submit context, so submit from an AFS cwd and keep the executable on AFS.
# The wrapper cd's into the EOS repo at runtime on the worker.
#
# Submit:
#   cd /afs/cern.ch/user/j/jekrupa/condor_bin
#   condor_submit /eos/user/j/jeffkrup/agentic/agentic-detector-design/condor/wave11_absval.sub
universe   = vanilla
executable = /afs/cern.ch/user/j/jekrupa/condor_bin/run_wave11_absval.sh

arguments  = --config $(CONFIG) --seed $(SEED) --n-events 20000

# Forward the kerberos credential so the worker can write to EOS.
MY.SendCredential = true

TAG = wave11_absval
log    = /afs/cern.ch/user/j/jekrupa/condor_logs/$(TAG).$(ClusterId).$(ProcId).log
output = /afs/cern.ch/user/j/jekrupa/condor_logs/$(TAG).$(ClusterId).$(ProcId).out
error  = /afs/cern.ch/user/j/jekrupa/condor_logs/$(TAG).$(ClusterId).$(ProcId).err

# Outputs go directly to EOS; no condor file transfer. The per-event dump
# (HEPEMSHOW_EVENT_DUMP, ~35 MB for AD configs) goes to the job-local tmp
# and is reduced to a small npz before the job ends.
should_transfer_files = NO

# Single-threaded forward-sim job; ~1 h of sim per unit at smoke-node speed.
request_cpus   = 1
request_memory = 2GB
request_disk   = 2GB

# "workday" = 8 h max walltime; the in-process sim timeout is 10800 s,
# leaving ample margin for slow nodes + EOS latency.
+JobFlavour = "workday"

queue CONFIG,SEED from (
abs_gov_val, 1
abs_gov_val, 2
abs_gov_val, 3
abs_gov_val, 4
abs_gov_val, 5
abs_gov_val, 6
abs_gov_val, 7
abs_gov_val, 8
abs_gov_val, 9
abs_gov_val, 10
abs_gov_od, 1
abs_gov_od, 2
abs_gov_od, 3
abs_gov_od, 4
abs_gov_od, 5
abs_gov_od, 6
abs_gov_od, 7
abs_gov_od, 8
abs_gov_od, 9
abs_gov_od, 10
abs_fd_od_plus, 1
abs_fd_od_plus, 2
abs_fd_od_plus, 3
abs_fd_od_plus, 4
abs_fd_od_plus, 5
abs_fd_od_plus, 6
abs_fd_od_plus, 7
abs_fd_od_plus, 8
abs_fd_od_plus, 9
abs_fd_od_plus, 10
abs_fd_od_minus, 1
abs_fd_od_minus, 2
abs_fd_od_minus, 3
abs_fd_od_minus, 4
abs_fd_od_minus, 5
abs_fd_od_minus, 6
abs_fd_od_minus, 7
abs_fd_od_minus, 8
abs_fd_od_minus, 9
abs_fd_od_minus, 10
)
